<section class="py-20 px-6 bg-white text-[#1e293b]">
  <div class="max-w-6xl mx-auto text-center">
    
    <!-- Título + Descripción -->
    <div id="impact-title" class="opacity-0 translate-y-10 transition-all duration-700 ease-out">
      <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6">Nuestro impacto</h2>
      <p class="text-lg md:text-xl mb-12 font-sans text-[#334155] max-w-3xl mx-auto">
        En <span class="text-yellow-500 font-semibold">ONCLICK</span> creemos en resultados reales. 
        Por eso, cada marca con la que trabajamos deja huella: medible, visible y emocional.
      </p>
    </div>

    <!-- Métricas en tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div id="metric-1" class="opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white shadow-lg rounded-2xl p-6 text-center border border-gray-100">
        <p id="count1" class="text-4xl font-bold text-yellow-500 mb-2">0</p>
        <p class="text-base text-[#475569]">Incremento promedio en alcance orgánico</p>
      </div>
      <div id="metric-2" class="opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white shadow-lg rounded-2xl p-6 text-center border border-gray-100">
        <p id="count2" class="text-4xl font-bold text-yellow-500 mb-2">0</p>
        <p class="text-base text-[#475569]">Marcas transformadas digitalmente</p>
      </div>
      <div id="metric-3" class="opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white shadow-lg rounded-2xl p-6 text-center border border-gray-100">
        <p id="count3" class="text-4xl font-bold text-yellow-500 mb-2">0</p>
        <p class="text-base text-[#475569]">Vistas acumuladas en campañas</p>
      </div>
    </div>

    <!-- Testimonio -->
    <blockquote id="impact-quote" class="italic text-[#475569] max-w-3xl mx-auto opacity-0 translate-y-10 transition-all duration-700 ease-out">
      “Con ONCLICK logramos mostrar el alma de nuestra marca en redes. Más que números, logramos conexión real.”<br />
      <span class="not-italic font-semibold text-sm text-yellow-500">– Cliente feliz</span>
    </blockquote>
  </div>

  <!-- Script de animación y contadores -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const counters = [
        { id: "count1", end: 120, suffix: "%" },
        { id: "count2", end: 30 },
        { id: "count3", end: 500000, suffix: "K", format: true }
      ];

      function animateValue(el, start, end, duration, suffix = "", format = false) {
        let startTime = null;
        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          const progress = Math.min((timestamp - startTime) / duration, 1);
          const value = Math.floor(progress * (end - start) + start);
          el.textContent = format ? (value / 1000).toFixed(0) + suffix : value + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Activar contadores
            counters.forEach(counter => {
              const el = document.getElementById(counter.id);
              if (el && !el.dataset.animated) {
                animateValue(el, 0, counter.end, 1500, counter.suffix || "", counter.format || false);
                el.dataset.animated = "true";
              }
            });

            // Animar elementos
            ['impact-title', 'metric-1', 'metric-2', 'metric-3', 'impact-quote'].forEach(id => {
              const el = document.getElementById(id);
              if (el) {
                el.classList.remove('opacity-0', 'translate-y-10');
                el.classList.add('opacity-100', 'translate-y-0');
              }
            });

            observer.disconnect(); // solo una vez
          }
        });
      }, { threshold: 0.4 });

      const triggerEl = document.getElementById("count1");
      if (triggerEl) observer.observe(triggerEl);
    });
  </script>
</section>
