<section id="nosotros" class="py-20 px-6 bg-white text-[#1e293b]">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">

    <!-- Texto animado -->
    <div id="nosotros-texto" class="opacity-0 -translate-x-10 transition-all duration-700 ease-out space-y-6">
      <h2 class="text-4xl md:text-5xl font-serif font-bold leading-tight">
        Somos más que una agencia,<br />
        somos <span class="text-yellow-500">creadoras de conexión</span>
      </h2>
      <p class="text-lg text-[#334155] leading-relaxed">
        ONCLICK nació de la creatividad y visión de dos jóvenes apasionadas por el contenido auténtico. 
        Nuestra misión es clara: transformar la forma en que las marcas se comunican en el mundo digital.
      </p>
      <p class="text-lg text-[#334155] leading-relaxed">
        Creemos en el poder de las ideas, en la estética con propósito y en las emociones que conectan. 
        Desde la estrategia hasta el diseño, llevamos cada marca a otro nivel.
      </p>
      <p class="italic text-sm text-[#475569]">
        Porque en ONCLICK, una buena idea siempre está a un clic de distancia.
      </p>
    </div>

    <!-- Imagen animada -->
    <div id="nosotros-imagen" class="opacity-0 translate-x-10 transition-all duration-700 ease-out">
      <img 
        src="/assets/gf/equipo.JPG" 
        alt="Equipo ONCLICK" 
        class="rounded-xl shadow-lg object-cover w-full h-[400px]" 
      />
    </div>

  </div>
</section>

<!-- Animación con IntersectionObserver -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const texto = document.getElementById("nosotros-texto");
          const imagen = document.getElementById("nosotros-imagen");

          if (texto) {
            texto.classList.remove("opacity-0", "-translate-x-10");
            texto.classList.add("opacity-100", "translate-x-0");
          }

          if (imagen) {
            imagen.classList.remove("opacity-0", "translate-x-10");
            imagen.classList.add("opacity-100", "translate-x-0");
          }

          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });

    const trigger = document.getElementById("nosotros");
    if (trigger) observer.observe(trigger);
  });
</script>