<section id="hablemos" class="py-20 px-6 bg-[#fefce8] text-[#1e293b]">
  <div id="hablemos-contenido" class="max-w-3xl mx-auto text-center space-y-6 opacity-0 scale-95 transition-all duration-700 ease-out">
    <h2 class="text-4xl md:text-5xl font-serif font-bold">
      ¿Tienes una idea?<br />
      <span class="text-yellow-600">Hablemos</span>
    </h2>

    <p class="text-lg text-[#334155]">
      Nos encanta escuchar ideas, compartir creatividad y crear estrategias con
      alma. Escribe sin miedo, estamos a un clic de distancia.
    </p>

    <a
      href="https://wa.me/573136632377"
      target="_blank"
      class="inline-block bg-yellow-500 text-white text-lg font-semibold px-6 py-3 rounded-full shadow-md hover:bg-yellow-600 transition"
    >
      Escribir por WhatsApp
    </a>

    <div class="text-sm text-[#475569] mt-4 text-center">
      o también puedes escribirnos por
      <a
        href="https://www.instagram.com/onclick_socialmedia/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-medium hover:text-yellow-600 transition-colors duration-200"
      >
        📸 @onclick_socialmedia
      </a>
    </div>
  </div>
</section>

<!-- Script de animación al scroll -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = document.getElementById("hablemos-contenido");
          if (el) {
            el.classList.remove("opacity-0", "scale-95");
            el.classList.add("opacity-100", "scale-100");
          }
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    const trigger = document.getElementById("hablemos");
    if (trigger) observer.observe(trigger);
  });
</script>