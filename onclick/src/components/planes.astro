      </div>
    </div>
  </div>
</section>

<!-- Script para animación al hacer scroll -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Título
          const title = document.getElementById("planes-title");
          if (title) {
            title.classList.remove("opacity-0", "translate-y-10");
            title.classList.add("opacity-100", "translate-y-0");
          }

          // Tarjetas
          const cards = document.querySelectorAll(".plan-card");
          cards.forEach((card) => {
            const delay = parseInt(card.dataset.delay || "0", 10);
            setTimeout(() => {
              card.classList.remove("opacity-0", "rotate-x-[25deg]", "scale-95");
              card.classList.add("opacity-100", "rotate-x-0", "scale-100");
            }, delay);
          });

          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    const trigger = document.getElementById("planes-grid");
    if (trigger) observer.observe(trigger);
  });
</script>